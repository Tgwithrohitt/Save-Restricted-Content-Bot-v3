# Copy to .env and fill locally. Never commit secrets.
API_ID=
API_HASH=
BOT_TOKEN=
MONGO_DB=
DB_NAME=telegram_post_vault

# Space-separated Telegram numeric IDs allowed to run /set (optional).
OWNER_ID=

# Required to encrypt saved Telegram sessions and custom-bot tokens.
# Keep these values unchanged while existing encrypted credentials are in use.
MASTER_KEY=
IV_KEY=

# Optional: require membership of this channel before saving/cloning. Use 0 to disable.
FORCE_SUB=0

# Optional large-file delivery path. Not needed for normal post saving.
LOG_GROUP=-1001234567890
STRING=
